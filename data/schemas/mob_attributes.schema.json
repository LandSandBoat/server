{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mob_attributes.schema.json",
  "title": "MobAttributes",
  "description": "Shared attributes defining battle entities. Reference as mob_attributes.schema.json#/$defs/<name>.",
  "type": "object",

  "$defs": {
    "stat_ranks": {
      "x-partial": true,
      "type": "object",
      "description": "Stat rank a-g. Lower is better. att and acc only handle a-e.",
      "unevaluatedProperties": false,
      "properties": {
        "str": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "dex": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "vit": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "agi": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "int": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "mnd": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "chr": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "def": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "eva": { "$ref": "enums/stat_rank.codegen.json", "default": "c" },
        "att": { "$ref": "enums/stat_rank.codegen.json", "default": "a" },
        "acc": { "$ref": "enums/stat_rank.codegen.json", "default": "a" }
      }
    },

    "mob_attributes": {
      "x-partial": true,
      "type": "object",
      "description": "Various attributes defining a battle entity. Valid at every level composing a mob from ecosystem all the way down to the individual spawns. Latest redefinition wins.",
      "properties": {
        "element": {
          "$ref": "enums/element.codegen.json",
          "default": "none",
          "description": "Elemental affinity of the entity."
        },
        "stats": {
          "$ref": "#/$defs/stat_ranks",
          "description": "Map of stat ranks for the entity."
        },
        "detects": {
          "type": "array",
          "items": { "$ref": "enums/detects.codegen.json" },
          "uniqueItems": true,
          "default": [],
          "description": "List of detection mechanisms for the entity. Redefine entire list if overridden."
        },
        "speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 40,
          "description": "Movement and animation speed. 0 is immobile."
        },
        "charmable": {
          "type": "boolean",
          "default": false,
          "description": "Entity charmable if true."
        }
      }
    }
  }
}
