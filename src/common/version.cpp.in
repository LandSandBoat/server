#include "common/version.h"

auto version::GetGitSha() -> const char*
{
    return "@GIT_SHA1@";
}

auto version::GetGitBranch() -> const char*
{
    return "@GIT_BRANCH@";
}

auto version::GetGitDate() -> const char*
{
    return "@GIT_DATE@";
}

auto version::GetGitCommitSubject() -> const char*
{
    return "@GIT_COMMIT_SUBJECT@";
}

auto version::GetVersionString() -> const char*
{
    return "@GIT_BRANCH@ (@GIT_SHA1@)";
}
