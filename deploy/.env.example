# Copie ce fichier en « .env » (dans deploy/) et ajuste les valeurs.
# .env ne doit PAS etre commite.

# --- Base de donnees ---
MARIADB_ROOT_PASSWORD=change-moi-root
MARIADB_DATABASE=xidb
MARIADB_USER=xiadmin
MARIADB_PASSWORD=change-moi

# --- Reseau ---
# IP que le client FFXI utilisera pour joindre les serveurs de zone.
#   127.0.0.1     -> le jeu tourne sur la meme machine que Docker
#   192.168.x.x   -> autres machines du LAN
#   <ip publique> -> Internet (il faut ouvrir les ports sur le routeur)
XI_ZONE_IP=127.0.0.1

# --- Image ---
# Tag de l'image construite depuis TON fork.
SERVER_IMAGE=ffxi/server:local
