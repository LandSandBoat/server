# Modele du fichier deploy/.env sur le serveur de production.
# Ne jamais commiter le .env reel.

MARIADB_ROOT_PASSWORD=change-moi-root
MARIADB_DATABASE=xidb
MARIADB_USER=xiadmin
MARIADB_PASSWORD=change-moi

# Adresse que le lobby renvoie au client pour joindre les zones.
# Serveur interne : son adresse LAN, joignable depuis les machines qui jouent.
XI_ZONE_IP=192.168.1.50

# Valeur de repli. deploy.sh la remplace par le tag exact deploye.
SERVER_IMAGE=ghcr.io/sekaroo/landsandboatserver:latest
