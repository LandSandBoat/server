# zoneip 自動更新の設定例。
# 実運用ではこの内容を参考に、/home/toshiaki/ffxi_server/.env.zoneip_update を作成して使う。

# MariaDB 接続設定
ZONEIP_DB_HOST=localhost
ZONEIP_DB_PORT=3306
ZONEIP_DB_NAME=xidb
ZONEIP_DB_USER=
ZONEIP_DB_PASS=

# 外部IP取得先。空白区切りで複数指定できる。
ZONEIP_IP_SOURCES="https://ifconfig.me https://ident.me https://api.ipify.org"

# zone_settings 更新後に順番に再起動するサービス。
ZONEIP_RESTART_SERVICES="xi-world.service xi-map.service xi-connect.service"

# 実行ロックの置き場
ZONEIP_LOCK_FILE=/var/lock/ffxi_zoneip_update.lock
